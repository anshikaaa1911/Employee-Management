{
  "name": "employee-goal-portal",
  "version": "1.0.0",
  "description": "Employee goal planning portal with a React frontend and Express API backend",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "server": "nodemon app.js",
    "dev": "nodemon app.js",
    "build": "npm install --prefix client && npm run build --prefix client",
    "db:check": "node config/checkDb.js",
    "seed": "node config/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "nodemonConfig": {
    "watch": [
      "app.js",
      "config",
      "controllers",
      "middleware",
      "models",
      "routes",
      "utils"
    ],
    "ext": "js,json",
    "ignore": [
      "client",
      "node_modules",
      "public",
      "views"
    ]
  },
  "author": "Hackathon Student",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.5.1",
    "morgan": "^1.10.0",
    "mongodb-memory-server": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
