<%- include('../partials/head', { title: 'Review Goal' }) %>
<%- include('../partials/navbar') %>
<div class="container py-4">
  <div class="card shadow-sm mx-auto" style="max-width: 760px;">
    <div class="card-body">
      <h3 class="card-title mb-3">Review Goal</h3>
      <% if (error && error.length > 0) { %>
        <div class="alert alert-danger"><%= error[0] %></div>
      <% } %>
      <div class="mb-3">
        <h5><%= goal.title %></h5>
        <p class="text-muted"><%= goal.description %></p>
        <p><strong>Employee:</strong> <%= goal.employeeId?.name %></p>
        <p><strong>Current Weightage:</strong> <%= goal.weightage %>%</p>
        <p><strong>Target:</strong> <%= goal.target %></p>
        <p><strong>Status:</strong> <%= goal.status %> • <strong>Approval:</strong> <%= goal.approvalStatus %></p>
      </div>
      <form method="POST" action="/manager/goals/<%= goal._id %>/edit" class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label">Target</label>
          <input name="target" type="number" class="form-control" value="<%= goal.target %>" required />
        </div>
        <div class="col-md-6">
          <label class="form-label">Weightage</label>
          <input name="weightage" type="number" class="form-control" value="<%= goal.weightage %>" required min="10" />
        </div>
        <div class="col-12">
          <label class="form-label">Manager Comment</label>
          <textarea name="managerComment" class="form-control" rows="3"><%= goal.managerComment %></textarea>
        </div>
        <div class="col-12 d-flex gap-2">
          <button type="submit" class="btn btn-outline-primary">Save Changes</button>
        </div>
      </form>
      <div class="d-flex gap-2">
        <form method="POST" action="/manager/goals/<%= goal._id %>/approve">
          <input type="hidden" name="managerComment" value="<%= goal.managerComment %>" />
          <button type="submit" class="btn btn-success">Approve</button>
        </form>
        <form method="POST" action="/manager/goals/<%= goal._id %>/reject">
          <input type="hidden" name="managerComment" value="<%= goal.managerComment %>" />
          <button type="submit" class="btn btn-danger">Reject</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
