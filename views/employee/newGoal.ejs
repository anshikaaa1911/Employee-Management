<%- include('../partials/head', { title: 'Create Goal' }) %>
<%- include('../partials/navbar') %>
<div class="container py-4">
  <div class="card shadow-sm mx-auto" style="max-width: 720px;">
    <div class="card-body">
      <h3 class="card-title mb-3">Create New Goal</h3>
      <% if (error && error.length > 0) { %>
        <div class="alert alert-danger"><%= error[0] %></div>
      <% } %>
      <form method="POST" action="/employee/goals/new">
        <div class="mb-3">
          <label class="form-label">Goal Title</label>
          <input name="title" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Description</label>
          <textarea name="description" class="form-control" rows="3"></textarea>
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">Thrust Area</label>
            <input name="thrustArea" class="form-control" required />
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">UOM Type</label>
            <select name="uomType" class="form-select" required>
              <option value="Min">Min</option>
              <option value="Max">Max</option>
              <option value="Zero">Zero</option>
            </select>
          </div>
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">Target</label>
            <input name="target" type="number" class="form-control" required />
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Weightage (%)</label>
            <input name="weightage" type="number" class="form-control" required min="10" />
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Save Goal</button>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
