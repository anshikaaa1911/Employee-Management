<%- include('../partials/head', { title: 'Admin Users' }) %>
<%- include('../partials/navbar') %>
<div class="container py-4">
  <h2>Manage Users</h2>
  <div class="table-responsive mt-3">
    <table class="table table-striped table-bordered">
      <thead class="table-light">
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Department</th>
          <th>Goals Completed</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach((userItem) => { %>
          <tr>
            <td><%= userItem.name %></td>
            <td><%= userItem.email %></td>
            <td><%= userItem.role %></td>
            <td><%= userItem.department %></td>
            <td><%= completion.find((item) => item.name === userItem.name)?.completed || 0 %> / <%= completion.find((item) => item.name === userItem.name)?.total || 0 %></td>
            <td>
              <form method="POST" action="/admin/users/<%= userItem._id %>/role" class="d-flex gap-2">
                <select name="role" class="form-select form-select-sm">
                  <option value="employee" <%= userItem.role === 'employee' ? 'selected' : '' %>>Employee</option>
                  <option value="manager" <%= userItem.role === 'manager' ? 'selected' : '' %>>Manager</option>
                  <option value="admin" <%= userItem.role === 'admin' ? 'selected' : '' %>>Admin</option>
                </select>
                <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
